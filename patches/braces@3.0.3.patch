diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..c917d64f4c39991c27f0c0aacfdae6a517d10399
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,18 @@
+'use strict';
+
+// Bound recursive walkers for both parsed patterns and caller-provided ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128 || seen.has(node)) {
+      throw new SyntaxError('Brace nesting exceeds the supported depth');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
