<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>NOVA AI · English client walkthrough</title><link rel="icon" href="data:,">
<style>
@font-face{font-family:Inter;src:url('assets/generated/inter.woff2') format('woff2');font-weight:500 800;font-display:block}
*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden;font-family:Inter,Arial,sans-serif;background:#111318;color:#fff}
#root{position:relative;width:1920px;height:1080px;overflow:hidden}#footage{position:absolute;inset:0;width:1920px;height:1080px;object-fit:fill}.layer{position:absolute;inset:0}.step{position:absolute;inset:0;pointer-events:none;visibility:hidden}
header{position:absolute;inset:0 0 auto;height:88px;background:#101217;display:flex;align-items:center;justify-content:space-between;padding:0 46px;gap:24px;border-bottom:1px solid #3b3d44}header span{font-size:28px;font-weight:650;white-space:nowrap}header small{font-size:21px;color:#d7b97a;letter-spacing:.5px}
footer{position:absolute;inset:auto 0 0;height:180px;background:#101217;display:flex;align-items:center;gap:30px;padding:24px 64px;border-top:1px solid #40434a}.number{font-size:30px;border:1px solid #5d6370;padding:17px;border-radius:12px;color:#e7e9ef}.caption{margin:0;font-size:40px;line-height:1.4;font-weight:600;max-width:1650px}
.card{position:absolute;inset:88px 0 180px;background:#e9eaed;color:#151820;padding:90px 100px;display:flex;flex-direction:column;justify-content:center}.card h1{font-size:70px;line-height:1.2;max-width:1600px;margin:16px 0 28px;font-weight:650;letter-spacing:-2px}.eyebrow{font-size:24px;letter-spacing:4px;color:#5e6470}.rule{width:100px;height:5px;background:#303744;margin:20px 0}.card-note{font-size:30px;color:#626977}.brand{background:transparent;align-items:center;text-align:center;box-shadow:inset 0 0 300px #080a1280}.brand-logo{width:670px;height:127px;background:url(assets/generated/logo-white.png) center/contain no-repeat;filter:drop-shadow(0 10px 30px #000)}.brand p{font-size:28px;letter-spacing:8px;color:#d8dce6;margin-top:36px}.paper{height:745px;width:auto;object-fit:contain;margin:auto;box-shadow:0 16px 70px #17191f33}.map{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;margin-top:30px}.map section{border-top:4px solid #3c475c;padding:18px 15px}.map h2{font-size:25px;font-weight:750;min-height:68px;line-height:1.4}.map p{font-size:25px;line-height:1.4;border-bottom:1px solid #c4c7ce;padding-bottom:15px;margin-bottom:15px}.card:has(.map){padding:45px 80px}.card:has(.map) h1{font-size:56px;margin:8px 0}.card:has(.paper){padding:10px}
</style>
<script>
window.novaErrors=[];window.novaError=function(message){window.novaErrors.push(message);let box=document.getElementById('nova-error');if(!box){box=document.createElement('pre');box.id='nova-error';box.setAttribute('role','alert');box.style.cssText='position:fixed;inset:20px;z-index:99999;background:#fff0f0;color:#841d1d;padding:30px;white-space:pre-wrap;overflow:auto;font:22px monospace';(document.body||document.documentElement).append(box);}box.textContent='NOVA tutorial · Complete production error\n\n'+window.novaErrors.join('\n\n');};
addEventListener('error',e=>window.novaError(e.error?.stack||e.message||'Asset failed: '+(e.target.src||e.target.href)),true);addEventListener('unhandledrejection',e=>window.novaError(e.reason?.stack||String(e.reason)));
</script><script src="assets/generated/status.js"></script><script src="assets/generated/gsap.min.js"></script></head><body>
