// ROLL ON. CMS — Prisma Schema
// 雙語官網 CMS：所有文字欄位用 Json {en, "zh-tw"} 儲存（雙語），
// 非文字欄位（slug / 圖片 URL / 外部連結 / 排序）用普通 column。
// 文檔單一事實來源：見專案根目錄 README.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 清單型內容（首頁各區塊，可 CRUD + 排序 + 隱藏）
// 文字欄位 Json 形如 { "en": "...", "zh-tw": "..." }
// ============================================

/// 服務項目（Services 區塊）
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique // 對應 /services/[slug] 路由
  icon      String // 圖示圖片 URL（Vercel Blob）
  title     Json // 雙語
  desc      Json // 雙語
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 活動（Events 區塊）
model Event {
  id          String   @id @default(cuid())
  date        Json // 顯示用雙語字串，如 {en:"11–12 MAY","zh-tw":"5月11–12日"}
  title       Json
  location    Json
  description Json
  image       String? // 活動圖片 URL，可空
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// 客戶 Logo（Clients 區塊）
model Client {
  id        String   @id @default(cuid())
  name      String // 品牌名（通常不翻譯）
  logo      String // logo 圖片 URL
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 案例（Work 區塊；目前皆屬 Medix LLC 群組）
model WorkCase {
  id          String   @id @default(cuid())
  group       String   @default("Medix LLC") // 案例分組標題
  image       String
  href        String // 外部連結（LinkedIn）
  description Json
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// 影片（GoldenTicket 區塊）
model Video {
  id        String   @id @default(cuid())
  thumb     String // 縮圖 URL
  href      String // YouTube 連結
  title     Json // 雙語
  views     String // 觀看數展示字串，如 "312 次"
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 深度指南預覽卡（InsightsTeaser 區塊；對應 /insights/[slug] 的 MDX 文章）
model InsightTeaser {
  id        String   @id @default(cuid())
  slug      String   @unique // 對應 MDX 檔案 slug
  title     Json
  blurb     Json
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ============================================
// Singleton 設定 / 翻譯覆蓋
// ============================================

/// 通用鍵值設定。key 範例：
///   "messages.en" / "messages.zh-tw" — next-intl 翻譯覆蓋（partial JSON，覆蓋靜態 messages/*.json）
///   "rollMapStats" — RollMap 區塊數值（mapData / comparison / topCompanies）
///   "contactInfo"  — Footer 聯絡資訊與社群連結
///   "goldenTicket" — GoldenTicket channel 標題 / 訂閱連結 / 圖片
model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ============================================
// 聯絡訊息（Footer 表單投遞）
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  locale    String? // 投遞時的語系
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ============================================
// 公開註冊使用者（與後台單一 admin 無關，獨立 user_session cookie）
// 註：使用者填寫的資料非雙語內容，故用一般欄位（非 Json 雙語）
// ============================================

/// 公開平台註冊用戶
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String? // Email 註冊者有值；Google 註冊者為 null
  firstName      String?
  lastName       String?
  googleId       String?   @unique // Google sub；Email 註冊者為 null
  image          String? // Google 頭像 URL，可空
  emailVerified  DateTime? // Google 帳號即視為已驗證
  onboardingStep Int       @default(1) // 1=account 2=company 3=requirements 4=quiz
  completed      Boolean   @default(false) // 全流程（含測驗）完成
  quizCompleted  Boolean   @default(false)

  // --- 計費 / 訂閱（全部 nullable 或有 default，純疊加；權威狀態由 webhook 對帳，此處為即時快取）---
  plan                 String    @default("free") // "free" | "pro" | "business" | "enterprise"
  subscriptionStatus   String? // PayPal 訂閱狀態快取：ACTIVE/PAST_DUE/SUSPENDED/CANCELLED/EXPIRED
  paypalSubscriptionId String?   @unique // 目前生效的 PayPal subscription id（I-XXXX）
  currentPeriodEnd     DateTime? // 本期到期 / 下次扣款時間，用於寬限期判斷
  planUpdatedAt        DateTime? // 最後一次方案異動時間

  // --- 管理員限時試用（不得再用假的 PayPal ACTIVE 模擬）---
  trialPlan     String?
  trialStartsAt DateTime?
  trialEndsAt   DateTime?

  // Tools 落地清單勾選狀態 { itemKey: true }
  checklistState Json @default("{}")

  // Milestones 使用者自訂：群組名稱覆寫與自訂項目；既有 checklistState 保持原用途
  milestoneConfig Json @default("{}")

  // Playbook 段落已讀狀態 { "<slug>:<segmentKey>": true }（供已讀/未讀 filter）
  playbookReads Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           OnboardingProfile?
  quizSubmissions   QuizSubmission[]
  subscriptions     Subscription[]
  aiAllowance       AiAllowance?
  aiUsages          AiUsage[]
  aiCreditPurchases AiCreditPurchase[]

  investorPortal              InvestorPortal?      @relation("InvestorPortalOwner")
  acceptedInvestorInvitations InvestorInvitation[] @relation("InvestorInvitationUser")

  // 會員後台工具（CRM / 銷售管道 / 會議記錄）— 皆 1:many、刪帳號連帶清除
  contacts     Contact[]
  deals        Deal[]
  meetingNotes MeetingNote[]

  // 雙週知識問答作答歷史（每期一筆）
  playbookQuizAttempts PlaybookQuizAttempt[]

  // 落地待辦頁的自訂任務（系統模板任務之外，會員自己加的）
  landingTasks LandingTask[]

  // NOVA 產生的版本化 Action Plan；與舊 LandingTask/checklistState 完全獨立
  actionPlans ActionPlan[]

  // 問題回報（產品 bug / 建議）
  feedbackReports FeedbackReport[]

  @@index([email])
}

/// Onboarding Step 2/3 資料（與 User 1:1）。欄位內容為推測，待設計確認。
model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Step 2：Company and industry information ---
  companyName String?
  industry    String?
  companySize String?
  website     String?
  country     String?

  // --- Step 3：Landing requirements assessment ---
  targetMarkets String[] // 目標亞洲市場（多選）
  needs         String[] // 服務需求（多選）
  timeline      String?
  budgetRange   String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// 創辦人決策風格測驗（註冊後流程）
// 題目與創辦人皆 CMS 可編輯（DB）；雙語文字用 Json {en, "zh-tw"}
// ============================================

/// 測驗題目（3 題 × 最多 4 選項；每選項自帶決策風格三維向量）
model QuizQuestion {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  dimension String // (legacy) 分類標籤；4 選項制改由各選項的 scores 三維向量計分，此欄不再驅動配對
  prompt    Json // 雙語
  subtitle  Json // 雙語
  // 選項 JSON：{ label, desc, icon, scores:{planningDepth,executionStrength,visionClarity} }，label/desc 雙語。
  // 舊資料相容：可能為 { ..., value:number }（搭配 dimension），submit 端會自動正規化。
  optionA   Json
  optionB   Json
  optionC   Json? // 第 3、4 選項（4 選項制用）；2 選項題留空
  optionD   Json?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 配對用創辦人 profile（連結既有 content/companies 檔）
model Founder {
  id          String  @id @default(cuid())
  slug        String  @unique
  companySlug String? // 連結 /company/<slug>，結果頁放「看完整分析」
  name        Json // 雙語
  role        Json // 雙語
  blurb       Json // 雙語
  traits      Json // 雙語字串陣列

  foundedYear   Int?
  statMarketCap String? // 顯示字串，如 "$2.0T"
  statSecondary Json? // { label:雙語, value:string } 第三張數據卡

  planningDepth     Int // 0~100（決策風格三維：配對 + 結果頁 bar）
  executionStrength Int
  visionClarity     Int

  timeline        Json // [{ year, title:雙語, desc:雙語 }]
  businessDetails Json // [{ heading:雙語, body:雙語 }]

  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions QuizSubmission[]

  @@index([published, order])
}

/// 測驗提交紀錄（後台唯讀清單）
model QuizSubmission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  founderId String?
  founder   Founder? @relation(fields: [founderId], references: [id], onDelete: SetNull)
  answers   Json // [{ questionId, choice:"A"|"B" }]
  scores    Json // { planningDepth, executionStrength, visionClarity }
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// 訂閱金流（PayPal）
// User 上的計費欄位是「目前生效狀態」快取；下列表記錄完整訂閱歷史與 webhook 事件，供對帳/除錯/出帳。
// ============================================

/// PayPal 訂閱紀錄（每次建立一筆；webhook 更新狀態）
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paypalSubscriptionId   String         @unique // I-XXXXXXXX
  checkoutRequestId      String?        @unique
  paypalPlanId           String // PayPal Billing Plan id（P-XXXX）
  plan                   String // 冗餘存方案 key（free/pro/business/enterprise），方便查詢
  status                 String // APPROVAL_PENDING/ACTIVE/SUSPENDED/CANCELLED/EXPIRED
  currentPeriodEnd       DateTime?
  startedAt              DateTime?
  cancelledAt            DateTime?
  billingInterval        String? // month / year；舊 TWD 資料保持 null
  currency               String? // USD / TWD；舊資料保持 null
  amountMinor            Int? // 最小貨幣單位，例如 USD 49.00 = 4900
  replacesSubscriptionId String?
  replacesSubscription   Subscription?  @relation("SubscriptionReplacement", fields: [replacesSubscriptionId], references: [id], onDelete: SetNull)
  replacedBy             Subscription[] @relation("SubscriptionReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([replacesSubscriptionId])
}

/// 目前 NOVA 月額度與永久加購餘額。週期按有效訂閱／trial 的開始日計算。
model AiAllowance {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cycleStart       DateTime?
  cycleEnd         DateTime?
  includedUsed     Int       @default(0)
  includedReserved Int       @default(0)
  bonusBalance     Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

/// NOVA 一次回答的 reservation／成功／失敗紀錄，用來避免多分頁超用。
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source      String // included / bonus
  status      String    @default("pending") // pending / succeeded / failed
  cycleStart  DateTime?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, status])
  @@index([expiresAt])
}

/// USD 5 / 10 次的 PayPal Orders v2 購買紀錄。
model AiCreditPurchase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paypalOrderId   String    @unique
  requestId       String    @unique
  paypalCaptureId String?   @unique
  status          String    @default("CREATED") // CREATED / COMPLETED / FAILED
  amountMinor     Int       @default(500)
  currency        String    @default("USD")
  credits         Int       @default(10)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
}

/// Webhook 事件去重（PayPal 會重送 + 可能亂序；event id 直接當主鍵天然冪等）
model WebhookEvent {
  id          String   @id // PayPal event id
  eventType   String
  resourceId  String? // subscription id 等
  payload     Json
  processedAt DateTime @default(now())

  @@index([eventType])
}

// ============================================
// 會員後台自助工具（每筆綁 userId、Pro 方案限定）
// 使用者自填資料、非雙語內容 → 用一般欄位。stage/status 用 String（app 端驗證）。
// ============================================

/// CRM 聯絡人（會員自己的客戶/夥伴清單）
model Contact {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  company  String?
  category String? // 聯絡人所屬的專案／分類（會員自訂文字）
  email    String?
  phone    String?
  status   String  @default("lead") // lead / active / closed（app 端驗證）
  notes    String?

  deals Deal[] // 反向關聯：連到此聯絡人的商機（刪聯絡人時商機的 contactId 設 null）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

/// 銷售管道商機（依 stage 分欄看板）
model Deal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  stage     String   @default("lead") // lead / contacted / proposal / won / lost
  value     Int? // 金額（整數，幣別由會員自訂/TWD），可空
  contactId String? // 可選連 CRM 聯絡人
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

/// 落地待辦頁的自訂任務
/// 系統任務來自 buildChecklist 模板（無 DB 列，勾選狀態存 User.checklistState）；
/// 此表只放會員自己新增的任務，兩者在 computeTasks() 合併成同一份清單。
/// dueAt 可空 → 由 app 端決定無期限任務的狀態與排序（見 src/lib/dashboard/agenda.ts）。
model LandingTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  dueAt DateTime? // 使用者自訂的目標日期，可空
  done  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, done])
}

/// NOVA Action Plan 的版本容器。
/// activeKey 啟用時固定等於 userId，nullable unique 保證每位使用者至多一份 active plan。
model ActionPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locale               String
  companyStage         String
  stageReason          String
  stageConfidence      Int
  bottleneckGroup      String
  bottleneckCode       String
  bottleneckReason     String
  bottleneckConfidence Int
  requestId            String
  activeKey            String?   @unique
  archivedAt           DateTime?

  actions   ActionItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

/// Action 的完整八維資料。priority score、rank、blocked 皆由 server 即時計算，不持久化。
model ActionItem {
  id           String     @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  clientKey    String
  title        String

  impact               String
  urgencyType          String
  urgencyDays          Int?
  dependencyLevel      Int     @default(0)
  dependencyNotes      String?
  difficulty           Int
  actionTimeMinHours   Int
  actionTimeMaxHours   Int
  // 2026-08 起以分鐘為 Action time 的權威值；nullable 讓既有 hours 資料零遺失相容。
  actionTimeMinMinutes Int?
  actionTimeMaxMinutes Int?

  companyStage            String
  stageFit                Int
  stageFitReason          String
  stageFitConfidence      Int?
  bottleneckGroup         String
  bottleneckCode          String
  bottleneckFit           Int
  bottleneckFitReason     String
  bottleneckFitConfidence Int?

  outcomeCategory    String
  expectedOutcome    String
  outcomeTimeMinDays Int
  outcomeTimeMaxDays Int

  done                      Boolean  @default(false)
  source                    String   @default("nova")
  stageFitEditedByUser      Boolean  @default(false)
  bottleneckFitEditedByUser Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  dependencies ActionDependency[] @relation("ActionDependencies")
  requiredBy   ActionDependency[] @relation("ActionDependents")

  @@unique([actionPlanId, clientKey])
  @@index([actionPlanId, done])
}

/// 同一 Action Plan 內的有向依賴：action 必須等待 dependsOn。
model ActionDependency {
  actionId    String
  dependsOnId String
  action      ActionItem @relation("ActionDependencies", fields: [actionId], references: [id], onDelete: Cascade)
  dependsOn   ActionItem @relation("ActionDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@id([actionId, dependsOnId])
  @@index([dependsOnId])
}

// ============================================
// Business / Enterprise Investor Portal
// 一家公司一份共用分享設定；所有區塊預設關閉。
// ============================================

model InvestorPortal {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("InvestorPortalOwner", fields: [userId], references: [id], onDelete: Cascade)

  shareProfile      Boolean @default(false)
  shareStrategy     Boolean @default(false)
  shareActionPlan   Boolean @default(false)
  shareKpis         Boolean @default(false)
  shareMilestones   Boolean @default(false)
  shareUpdates      Boolean @default(false)
  shareBusinessPlan Boolean @default(false)

  // Enterprise 專屬的逐欄位隱藏（deny-list，值域見 src/lib/investor/fields.ts）。
  // 刻意存「被隱藏的 key」而非「可見的 key」：日後新增欄位時預設可見，
  // 舊 portal 不會因為沒跟上新欄位而憑空少東西。
  //
  // 重要：這份設定的「套用」永遠無條件執行，只有「修改」需要 Enterprise。
  // 否則 Enterprise 降級為 Business 的瞬間，刻意藏起來的資料會突然對投資人曝光。
  hiddenFields String[]

  businessPlanPath       String?
  businessPlanFilename   String?
  businessPlanMime       String?
  businessPlanSize       Int?
  businessPlanUploadedAt DateTime?

  kpis        InvestorKpi[]
  milestones  InvestorMilestone[]
  updates     InvestorUpdate[]
  invitations InvestorInvitation[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model InvestorKpi {
  id        String         @id @default(cuid())
  portalId  String
  portal    InvestorPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  label     String
  // 當前值／標籤，自由文字（"USD 1.2M"、"38%"）。走勢圖另看 points。
  value     String
  period    String?
  // 走勢圖的 Y 軸單位，沿用 content/companies 的 Metric.unit 慣例
  unit      String?
  // Enterprise 專屬：單筆隱藏。與 hiddenFields 同樣「無條件生效、僅修改需方案」。
  hidden    Boolean        @default(false)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  points InvestorKpiPoint[]

  @@index([portalId, order])
}

// KPI 的時間序列數值。InvestorKpi.value(String) 保留為「當前值」，
// points 為選配 —— 沒有 points 的既有 KPI 行為與過去完全一致，零遷移。
model InvestorKpiPoint {
  id        String      @id @default(cuid())
  kpiId     String
  kpi       InvestorKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period    String // "2025-Q1" / "2025-06"，自由文字，沿用 Company.Metric.period
  value     Float
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([kpiId, period])
  @@index([kpiId, order])
}

model InvestorMilestone {
  id         String         @id @default(cuid())
  portalId   String
  portal     InvestorPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  title      String
  status     String         @default("planned") // planned / in_progress / done
  targetDate DateTime?
  notes      String?
  // Enterprise 專屬：單筆隱藏（無條件生效，僅修改需方案）
  hidden     Boolean        @default(false)
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([portalId, order])
}

model InvestorUpdate {
  id          String         @id @default(cuid())
  portalId    String
  portal      InvestorPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime       @default(now())
  // Enterprise 專屬：單筆隱藏（無條件生效，僅修改需方案）
  hidden      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([portalId, publishedAt])
}

model InvestorInvitation {
  id       String         @id @default(cuid())
  portalId String
  portal   InvestorPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  invitedEmail     String
  activeKey        String?   @unique
  tokenHash        String?   @unique
  status           String    @default("pending") // pending / accepted / revoked / expired
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  lastSentAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("InvestorInvitationUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([portalId, status])
  @@index([acceptedByUserId])
  @@index([invitedEmail])
}

/// 會議記錄
model MeetingNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  meetingAt DateTime? // 會議時間，可空

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Rate limiting（DB-based 固定視窗；本專案無 KV/Redis，改用 Neon 做跨 serverless 實例的持久計數）
// 用途：Copilot 每會員每日配額（成本護欄）、登入/註冊/改密碼的暴力嘗試上限。
// key 範例："copilot:<userId>"、"login:<ip>:<email>"。過窗即重置（見 src/lib/rate-limit.ts）。
// ============================================

/// 固定視窗計數器（每個 key 一列）
model RateCounter {
  key         String   @id
  windowStart DateTime // 當前視窗起點；now - windowStart >= 視窗長度時重置
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart]) // 供日後清理過期列
}

// ============================================
// 雙週知識問答（Playbook Q&A）作答歷史
// 題目從 playbook 段落題庫即時挑選（不入 DB）；此表只存「每會員每期作答結果」，供成績/歷史/防重複作答。
// periodIndex = 以會員註冊日為錨算出的第幾個雙週（見 src/lib/playbook/quiz.ts）。
// ============================================

/// 每會員每個雙週一筆作答紀錄
model PlaybookQuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodIndex Int // 第幾個雙週（錨=註冊日）
  answers     Json // [{ questionId, choice }]
  score       Int
  total       Int
  createdAt   DateTime @default(now())

  @@unique([userId, periodIndex]) // 每期一筆
  @@index([userId])
}

// ============================================
// 問題回報（會員後台送出 → 管理員後台處理）
// 刻意「不」做方案 gating：bug/建議是我們想要更多、不是更少的訊號，
// 免費會員一樣能回報；濫用護欄改用 rate limit（見 src/lib/dashboard/feedback.ts）。
// ============================================

/// 會員回報的產品問題或建議
model FeedbackReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // bug / suggestion / other（app 端驗證，見 FEEDBACK_TYPES）
  title String
  body  String

  // --- 重現用診斷資訊（會員填/前端自動帶；userAgent 由 server 從 header 取，不信 client）---
  pageUrl   String? // 回報當下所在頁面
  locale    String? // 回報時的語系
  userAgent String?

  // --- 處理狀態（管理員後台維護）---
  status     String    @default("open") // open / in_progress / resolved / wontfix
  adminReply String? // 管理員回覆 —— 會員在自己的回報清單看得到
  resolvedAt DateTime? // 首次進入終局狀態（resolved/wontfix）的時間

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
