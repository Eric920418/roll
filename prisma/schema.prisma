// ROLL ON. CMS — Prisma Schema
// 雙語官網 CMS：所有文字欄位用 Json {en, "zh-tw"} 儲存（雙語），
// 非文字欄位（slug / 圖片 URL / 外部連結 / 排序）用普通 column。
// 文檔單一事實來源：見專案根目錄 README.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 清單型內容（首頁各區塊，可 CRUD + 排序 + 隱藏）
// 文字欄位 Json 形如 { "en": "...", "zh-tw": "..." }
// ============================================

/// 服務項目（Services 區塊）
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique // 對應 /services/[slug] 路由
  icon      String // 圖示圖片 URL（Vercel Blob）
  title     Json // 雙語
  desc      Json // 雙語
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 活動（Events 區塊）
model Event {
  id          String   @id @default(cuid())
  date        Json // 顯示用雙語字串，如 {en:"11–12 MAY","zh-tw":"5月11–12日"}
  title       Json
  location    Json
  description Json
  image       String? // 活動圖片 URL，可空
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// 客戶 Logo（Clients 區塊）
model Client {
  id        String   @id @default(cuid())
  name      String // 品牌名（通常不翻譯）
  logo      String // logo 圖片 URL
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 案例（Work 區塊；目前皆屬 Medix LLC 群組）
model WorkCase {
  id          String   @id @default(cuid())
  group       String   @default("Medix LLC") // 案例分組標題
  image       String
  href        String // 外部連結（LinkedIn）
  description Json
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// 影片（GoldenTicket 區塊）
model Video {
  id        String   @id @default(cuid())
  thumb     String // 縮圖 URL
  href      String // YouTube 連結
  title     Json // 雙語
  views     String // 觀看數展示字串，如 "312 次"
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 深度指南預覽卡（InsightsTeaser 區塊；對應 /insights/[slug] 的 MDX 文章）
model InsightTeaser {
  id        String   @id @default(cuid())
  slug      String   @unique // 對應 MDX 檔案 slug
  title     Json
  blurb     Json
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ============================================
// Singleton 設定 / 翻譯覆蓋
// ============================================

/// 通用鍵值設定。key 範例：
///   "messages.en" / "messages.zh-tw" — next-intl 翻譯覆蓋（partial JSON，覆蓋靜態 messages/*.json）
///   "rollMapStats" — RollMap 區塊數值（mapData / comparison / topCompanies）
///   "contactInfo"  — Footer 聯絡資訊與社群連結
///   "goldenTicket" — GoldenTicket channel 標題 / 訂閱連結 / 圖片
model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ============================================
// 聯絡訊息（Footer 表單投遞）
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  locale    String? // 投遞時的語系
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ============================================
// 公開註冊使用者（與後台單一 admin 無關，獨立 user_session cookie）
// 註：使用者填寫的資料非雙語內容，故用一般欄位（非 Json 雙語）
// ============================================

/// 公開平台註冊用戶
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String? // Email 註冊者有值；Google 註冊者為 null
  firstName      String?
  lastName       String?
  googleId       String?   @unique // Google sub；Email 註冊者為 null
  image          String? // Google 頭像 URL，可空
  emailVerified  DateTime? // Google 帳號即視為已驗證
  onboardingStep Int       @default(1) // 1=account 2=company 3=requirements 4=quiz
  completed      Boolean   @default(false) // 全流程（含測驗）完成
  quizCompleted  Boolean   @default(false)

  // --- 計費 / 訂閱（全部 nullable 或有 default，純疊加；權威狀態由 webhook 對帳，此處為即時快取）---
  plan                 String    @default("free") // "free" | "pro" | "business" | "enterprise"
  subscriptionStatus   String? // PayPal 訂閱狀態快取：ACTIVE/PAST_DUE/SUSPENDED/CANCELLED/EXPIRED
  paypalSubscriptionId String?   @unique // 目前生效的 PayPal subscription id（I-XXXX）
  currentPeriodEnd     DateTime? // 本期到期 / 下次扣款時間，用於寬限期判斷
  planUpdatedAt        DateTime? // 最後一次方案異動時間

  // Tools 落地清單勾選狀態 { itemKey: true }
  checklistState Json @default("{}")

  // Playbook 段落已讀狀態 { "<slug>:<segmentKey>": true }（供已讀/未讀 filter）
  playbookReads Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         OnboardingProfile?
  quizSubmissions QuizSubmission[]
  subscriptions   Subscription[]

  // 會員後台工具（CRM / 銷售管道 / 會議記錄）— 皆 1:many、刪帳號連帶清除
  contacts     Contact[]
  deals        Deal[]
  meetingNotes MeetingNote[]

  // 雙週知識問答作答歷史（每期一筆）
  playbookQuizAttempts PlaybookQuizAttempt[]

  // 落地待辦頁的自訂任務（系統模板任務之外，會員自己加的）
  landingTasks LandingTask[]

  @@index([email])
}

/// Onboarding Step 2/3 資料（與 User 1:1）。欄位內容為推測，待設計確認。
model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Step 2：Company and industry information ---
  companyName String?
  industry    String?
  companySize String?
  website     String?
  country     String?

  // --- Step 3：Landing requirements assessment ---
  targetMarkets String[] // 目標亞洲市場（多選）
  needs         String[] // 服務需求（多選）
  timeline      String?
  budgetRange   String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// 創辦人決策風格測驗（註冊後流程）
// 題目與創辦人皆 CMS 可編輯（DB）；雙語文字用 Json {en, "zh-tw"}
// ============================================

/// 測驗題目（3 題 × 最多 4 選項；每選項自帶決策風格三維向量）
model QuizQuestion {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  dimension String // (legacy) 分類標籤；4 選項制改由各選項的 scores 三維向量計分，此欄不再驅動配對
  prompt    Json // 雙語
  subtitle  Json // 雙語
  // 選項 JSON：{ label, desc, icon, scores:{planningDepth,executionStrength,visionClarity} }，label/desc 雙語。
  // 舊資料相容：可能為 { ..., value:number }（搭配 dimension），submit 端會自動正規化。
  optionA   Json
  optionB   Json
  optionC   Json? // 第 3、4 選項（4 選項制用）；2 選項題留空
  optionD   Json?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// 配對用創辦人 profile（連結既有 content/companies 檔）
model Founder {
  id          String  @id @default(cuid())
  slug        String  @unique
  companySlug String? // 連結 /company/<slug>，結果頁放「看完整分析」
  name        Json // 雙語
  role        Json // 雙語
  blurb       Json // 雙語
  traits      Json // 雙語字串陣列

  foundedYear   Int?
  statMarketCap String? // 顯示字串，如 "$2.0T"
  statSecondary Json? // { label:雙語, value:string } 第三張數據卡

  planningDepth     Int // 0~100（決策風格三維：配對 + 結果頁 bar）
  executionStrength Int
  visionClarity     Int

  timeline        Json // [{ year, title:雙語, desc:雙語 }]
  businessDetails Json // [{ heading:雙語, body:雙語 }]

  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions QuizSubmission[]

  @@index([published, order])
}

/// 測驗提交紀錄（後台唯讀清單）
model QuizSubmission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  founderId String?
  founder   Founder? @relation(fields: [founderId], references: [id], onDelete: SetNull)
  answers   Json // [{ questionId, choice:"A"|"B" }]
  scores    Json // { planningDepth, executionStrength, visionClarity }
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// 訂閱金流（PayPal）
// User 上的計費欄位是「目前生效狀態」快取；下列表記錄完整訂閱歷史與 webhook 事件，供對帳/除錯/出帳。
// ============================================

/// PayPal 訂閱紀錄（每次建立一筆；webhook 更新狀態）
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  paypalSubscriptionId String  @unique // I-XXXXXXXX
  paypalPlanId         String // PayPal Billing Plan id（P-XXXX）
  plan                 String // 冗餘存方案 key（free/pro/business/enterprise），方便查詢
  status               String // APPROVAL_PENDING/ACTIVE/SUSPENDED/CANCELLED/EXPIRED
  currentPeriodEnd     DateTime?
  startedAt            DateTime?
  cancelledAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Webhook 事件去重（PayPal 會重送 + 可能亂序；event id 直接當主鍵天然冪等）
model WebhookEvent {
  id          String   @id // PayPal event id
  eventType   String
  resourceId  String? // subscription id 等
  payload     Json
  processedAt DateTime @default(now())

  @@index([eventType])
}

// ============================================
// 會員後台自助工具（每筆綁 userId、Pro 方案限定）
// 使用者自填資料、非雙語內容 → 用一般欄位。stage/status 用 String（app 端驗證）。
// ============================================

/// CRM 聯絡人（會員自己的客戶/夥伴清單）
model Contact {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  company String?
  email   String?
  phone   String?
  status  String  @default("lead") // lead / active / closed（app 端驗證）
  notes   String?

  deals Deal[] // 反向關聯：連到此聯絡人的商機（刪聯絡人時商機的 contactId 設 null）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

/// 銷售管道商機（依 stage 分欄看板）
model Deal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  stage     String   @default("lead") // lead / contacted / proposal / won / lost
  value     Int? // 金額（整數，幣別由會員自訂/TWD），可空
  contactId String? // 可選連 CRM 聯絡人
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

/// 落地待辦頁的自訂任務
/// 系統任務來自 buildChecklist 模板（無 DB 列，勾選狀態存 User.checklistState）；
/// 此表只放會員自己新增的任務，兩者在 computeTasks() 合併成同一份清單。
/// dueAt 可空 → 由 app 端決定無期限任務的狀態與排序（見 src/lib/dashboard/agenda.ts）。
model LandingTask {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  dueAt DateTime? // 使用者自訂的目標日期，可空
  done  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, done])
}

/// 會議記錄
model MeetingNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  meetingAt DateTime? // 會議時間，可空

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Rate limiting（DB-based 固定視窗；本專案無 KV/Redis，改用 Neon 做跨 serverless 實例的持久計數）
// 用途：Copilot 每會員每日配額（成本護欄）、登入/註冊/改密碼的暴力嘗試上限。
// key 範例："copilot:<userId>"、"login:<ip>:<email>"。過窗即重置（見 src/lib/rate-limit.ts）。
// ============================================

/// 固定視窗計數器（每個 key 一列）
model RateCounter {
  key         String   @id
  windowStart DateTime // 當前視窗起點；now - windowStart >= 視窗長度時重置
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart]) // 供日後清理過期列
}

// ============================================
// 雙週知識問答（Playbook Q&A）作答歷史
// 題目從 playbook 段落題庫即時挑選（不入 DB）；此表只存「每會員每期作答結果」，供成績/歷史/防重複作答。
// periodIndex = 以會員註冊日為錨算出的第幾個雙週（見 src/lib/playbook/quiz.ts）。
// ============================================

/// 每會員每個雙週一筆作答紀錄
model PlaybookQuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodIndex Int // 第幾個雙週（錨=註冊日）
  answers     Json // [{ questionId, choice }]
  score       Int
  total       Int
  createdAt   DateTime @default(now())

  @@unique([userId, periodIndex]) // 每期一筆
  @@index([userId])
}
